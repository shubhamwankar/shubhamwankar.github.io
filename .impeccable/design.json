      "css": ".ds-link{font-family:var(--font-portfolio,Cambay),sans-serif;display:inline-flex;align-items:center;gap:8px;min-height:44px;font-size:16px;line-height:1.6;font-weight:700;color:hsl(var(--primary,184 86% 23%));text-decoration:none;text-underline-offset:4px;}.ds-link:hover{text-decoration:underline;}.ds-link:focus-visible{outline:2px solid hsl(var(--ring,184 86% 23%));outline-offset:5px;border-radius:3px;}"
