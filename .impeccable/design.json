      "css": ".ds-secondary{font-family:var(--font-portfolio,Cambay),sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:48px;padding:10px 16px 8px;border:1px solid hsl(var(--primary,184 86% 23%));border-radius:var(--radius,.375rem);font-size:15px;font-weight:700;line-height:1.6;text-decoration:none;transition:background-color 150ms,color 150ms;background:transparent;color:hsl(var(--primary,184 86% 23%));}.ds-secondary:hover{background:hsl(var(--accent,191 44% 92%));}.ds-secondary:focus-visible{outline:2px solid hsl(var(--ring,184 86% 23%));outline-offset:5px;border-radius:3px;}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-secondary,.ds-project svg{transition:none;}}"
