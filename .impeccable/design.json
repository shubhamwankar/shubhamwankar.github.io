      "css": ".ds-nav{font-family:var(--font-portfolio,Cambay),sans-serif;display:flex;flex-wrap:wrap;gap:24px;background:hsl(var(--background,0 0% 100%));}.ds-nav a{display:flex;align-items:center;min-height:48px;color:hsl(var(--muted-foreground,211 30% 43%));font-size:14px;text-decoration:none;}.ds-nav a:hover{color:hsl(var(--primary,184 86% 23%));}.ds-nav a:focus-visible{outline:2px solid hsl(var(--ring,184 86% 23%));outline-offset:5px;border-radius:3px;}"
