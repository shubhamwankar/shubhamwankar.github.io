    {
      "name": "Project disclosure",
      "kind": "custom",
      "refersTo": "project-disclosure",
      "description": "Native disclosure with technology context and an expanding detail area.",
      "html": "<details class=\"ds-project\"><summary><div><h3>Applied AI project</h3><p>Python · Machine learning</p></div><svg width=\"21\" height=\"21\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg></summary><div class=\"ds-project-body\">Project description and repository link.</div></details>",
      "css": ".ds-project{font-family:var(--font-portfolio,Cambay),sans-serif;border-bottom:1px solid hsl(var(--border,211 26% 84%));color:hsl(var(--foreground,224 70% 12%));}.ds-project summary{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:24px 0;cursor:pointer;list-style:none;}.ds-project summary::-webkit-details-marker{display:none;}.ds-project h3{font-size:20px;font-weight:700;line-height:1.2;letter-spacing:-.015em;margin:0;}.ds-project p{font-size:13px;line-height:1.7;margin:6px 0 0;color:hsl(var(--muted-foreground,211 30% 43%));}.ds-project summary:hover h3{color:hsl(var(--primary,184 86% 23%));}.ds-project summary:focus-visible{outline:2px solid hsl(var(--ring,184 86% 23%));outline-offset:5px;border-radius:3px;}.ds-project svg{flex-shrink:0;transition:transform 180ms ease-out;}.ds-project[open] summary>svg{transform:rotate(45deg);}.ds-project-body{padding-bottom:28px;font-size:16px;line-height:1.6;color:hsl(var(--muted-foreground,211 30% 43%));}@media(min-width:960px){.ds-project summary{padding:28px 0;}.ds-project h3{font-size:24px;}.ds-project p{font-size:14px;}}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-secondary,.ds-project svg{transition:none;}}"
    },
    {
      "name": "Timing comparison",
      "kind": "custom",
      "description": "Two unboxed metric columns, with teal on the improved result.",
      "html": "<div class=\"ds-timing\"><div><span>Previous service</span><strong>~8 min</strong></div><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M5 12h14m-7-7 7 7-7 7\"/></svg><div><span>New service</span><strong>&lt;1 min</strong></div></div>",
      "css": ".ds-timing{font-family:var(--font-portfolio,Cambay),sans-serif;display:grid;grid-template-columns:1fr 30px 1fr;align-items:center;gap:8px;color:hsl(var(--foreground,224 70% 12%));}.ds-timing span{display:block;color:hsl(var(--muted-foreground,211 30% 43%));font-size:15px;margin-top:1px;}.ds-timing strong{display:block;margin-top:7px;font-size:35px;font-weight:700;line-height:1.1;letter-spacing:-.04em;font-variant-numeric:tabular-nums;}.ds-timing>svg{color:hsl(var(--muted-foreground,211 30% 43%));margin-top:20px;}.ds-timing>div:last-child{padding-left:9px;}.ds-timing>div:last-child strong{color:hsl(var(--primary,184 86% 23%));}@media(min-width:960px){.ds-timing strong{font-size:46px;}.ds-timing span{font-size:14px;}}"
